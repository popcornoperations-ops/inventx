{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env DATABASE_URL=\"file:./dev.db\" ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "cross-env DATABASE_URL=\"file:./dev.db\" node dist/main.js",
    "lint": "eslint .",
    "prisma:generate": "cross-env DATABASE_URL=\"file:./dev.db\" prisma generate",
    "prisma:migrate": "cross-env DATABASE_URL=\"file:./dev.db\" prisma migrate dev",
    "prisma:studio": "cross-env DATABASE_URL=\"file:./dev.db\" prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.7",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@prisma/client": "^5.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "prisma": "^5.20.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}

